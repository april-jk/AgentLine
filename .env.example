# AgentLine Development Environment
# Copy to .env and modify as needed

# Logging (file logging is off by default)
# LOG_TO_FILE=true       # Enable server log file ({dataDir}/logs/server.log)
# LOG_LEVEL=debug        # trace, debug, info, warn, error, fatal
# LOG_FILE_LEVEL=debug   # Separate level for file logging
# LOG_PRETTY=false       # Disable pretty console output (default: true)

# Ports (derived from PORT: server=PORT, maintenance=PORT+1, vite=PORT+2)
# PORT=3400

# Profile for data directory
# AGENTLINE_PROFILE=dev

# Enable HTTPS using an auto-generated self-signed certificate
# HTTPS_SELF_SIGNED=true

# Raw SDK message logging (writes to {logDir}/sdk-raw.jsonl)
# LOG_SDK_MESSAGES=true

# Codex session watcher fallback rescan (ms). Default on macOS: 5000, other OS: 0 (disabled).
# Set to 0 to disable periodic fallback rescan.
# CODEX_WATCH_PERIODIC_RESCAN_MS=5000

# Session index full validation interval (ms). 0 = validate every request.
# SESSION_INDEX_FULL_VALIDATION_MS=30000

# Session index write lock timeout (ms) for multi-instance coordination.
# SESSION_INDEX_WRITE_LOCK_TIMEOUT_MS=2000

# Session index lock stale threshold (ms) before stale lock cleanup.
# SESSION_INDEX_WRITE_LOCK_STALE_MS=10000

# Project scan cache TTL (ms). 0 = rescan on every request.
# PROJECT_SCAN_CACHE_TTL_MS=5000

# Voice Secretary: Volcengine speech services
# Do not commit real values. Copy this file to .env and fill these locally.
#
# Shared console application credentials for Doubao Speech / OpenSpeech.
# VOLCENGINE_SPEECH_APP_ID=
# VOLCENGINE_SPEECH_ACCESS_TOKEN=
#
# Streaming ASR over WebSocket.
# VOLCENGINE_ASR_ENDPOINT=wss://openspeech.bytedance.com/api/v2/asr
# VOLCENGINE_ASR_CLUSTER=
# VOLCENGINE_ASR_LANGUAGE=zh-CN
#
# Speech synthesis / TTS over WebSocket.
# VOLCENGINE_TTS_ENDPOINT=wss://openspeech.bytedance.com/api/v1/tts/ws_binary
# VOLCENGINE_TTS_CLUSTER=
# VOLCENGINE_TTS_VOICE_TYPE=
# VOLCENGINE_TTS_AUDIO_ENCODING=mp3
