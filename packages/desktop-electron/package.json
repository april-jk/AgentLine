{
  "name": "@agentline/desktop-electron",
  "version": "1.0.5",
  "private": true,
  "type": "module",
  "description": "Electron desktop shell for AgentLine.",
  "author": {
    "name": "april-jk",
    "email": "april-jk@users.noreply.github.com"
  },
  "homepage": "https://github.com/april-jk/AgentLine",
  "repository": {
    "type": "git",
    "url": "https://github.com/april-jk/AgentLine.git"
  },
  "bugs": {
    "url": "https://github.com/april-jk/AgentLine/issues"
  },
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "pnpm run build:renderer && pnpm run build:electron",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "prepare:runtime": "node scripts/prepare-runtime.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "start": "pnpm run build && pnpm exec electron .",
    "dist:dir": "pnpm run build && pnpm run prepare:runtime && pnpm exec electron-builder --dir",
    "dist:mac": "pnpm run build && pnpm run prepare:runtime && pnpm exec electron-builder --mac dmg zip --publish never",
    "dist:win": "pnpm run build && pnpm run prepare:runtime && pnpm exec electron-builder --win nsis portable --publish never",
    "dist:linux": "pnpm run build && pnpm run prepare:runtime && pnpm exec electron-builder --linux AppImage deb --publish never"
  },
  "dependencies": {
    "@agentline/shared": "workspace:*",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.6.0",
    "electron": "^31.7.7",
    "electron-builder": "^25.1.8",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  },
  "build": {
    "appId": "com.agentline.desktop.electron",
    "productName": "AgentLine Desktop",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "runtime",
        "to": "runtime",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "icon": "../desktop/src-tauri/icons/icon.icns",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "../desktop/src-tauri/icons/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "icon": "../desktop/src-tauri/icons/icon.png",
      "artifactName": "agentline-desktop-${version}-${arch}.${ext}",
      "executableName": "agentline-desktop",
      "target": [
        "AppImage",
        "deb"
      ]
    }
  }
}
