{
  "expo": {
    "name": "AgentLine",
    "slug": "agentline-mobile-rn",
    "version": "1.0.6",
    "description": "AgentLine mobile client for securely connecting to your desktop AI sessions over direct LAN or relay mode.",
    "icon": "./assets/icon.png",
    "newArchEnabled": false,
    "scheme": "agentline-mobile",
    "plugins": [
      "./plugins/with-local-network-info"
    ],
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#181818"
    },
    "ios": {
      "bundleIdentifier": "com.agentline.mobile.rn",
      "supportsTablet": false,
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "AgentLine uses local network access to discover and connect to your desktop host securely.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.agentline.mobile.rn",
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#181818"
      }
    },
    "platforms": [
      "ios",
      "android"
    ],
    "assetBundlePatterns": [
      "**/*"
    ]
  }
}
