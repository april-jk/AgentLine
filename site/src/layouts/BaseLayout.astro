---
import "../index.css";
import { withBase } from "../lib/paths";

interface Props {
  title: string;
  description: string;
  ogType?: string;
  ogImage?: string;
  publishedTime?: string;
  canonicalPath?: string;
}

const {
  title,
  description,
  ogType = "website",
  ogImage,
  publishedTime,
  canonicalPath,
} = Astro.props;
const pathname = (canonicalPath || Astro.url.pathname).replace(/\.html$/, "");
const canonicalURL = new URL(pathname, Astro.site);
const ogImageURL = ogImage
  ? new URL(ogImage, Astro.site)
  : new URL("/branding/og-image.png", Astro.site);
const siteStructuredData = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": new URL("/#organization", Astro.site).href,
      name: "AgentLine",
      url: Astro.site?.href,
      logo: new URL("/icon-512.png", Astro.site).href,
      sameAs: ["https://github.com/april-jk/AgentLine"],
    },
    {
      "@type": "WebSite",
      "@id": new URL("/#website", Astro.site).href,
      name: "AgentLine",
      url: Astro.site?.href,
      publisher: {
        "@id": new URL("/#organization", Astro.site).href,
      },
    },
    {
      "@type": "SoftwareApplication",
      "@id": new URL("/#software", Astro.site).href,
      name: "AgentLine",
      applicationCategory: "DeveloperApplication",
      operatingSystem: "macOS, Windows, Linux, Android, iOS",
      description,
      url: Astro.site?.href,
      image: ogImageURL.href,
      publisher: {
        "@id": new URL("/#organization", Astro.site).href,
      },
      offers: {
        "@type": "Offer",
        price: "0",
        priceCurrency: "USD",
      },
    },
  ],
});
---

<!doctype html>
<html lang="en">
  <head>
    <script is:inline>
    (function() {
      var t = localStorage.getItem('theme');
      if (t === 'light' || t === 'dark') {
        document.documentElement.setAttribute('data-theme', t);
      } else if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
        document.documentElement.setAttribute('data-theme', 'dark');
      } else {
        document.documentElement.setAttribute('data-theme', 'light');
      }
    })();
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="google-site-verification" content="Ttn0H1Z_g4-AkmAsWj_ddRsSwrqQSwP9PLDoA87XU9w" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="application-name" content="AgentLine" />
    <meta name="apple-mobile-web-app-title" content="AgentLine" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f5f7fb" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#08111b" />
    <link rel="icon" type="image/x-icon" href={withBase("/favicon.ico?v=agentline-image2")} />
    <link rel="icon" type="image/png" href={withBase("/icon-192.png?v=agentline-image2")} />
    <link rel="apple-touch-icon" href={withBase("/icon-192.png?v=agentline-image2")} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Sora:wght@500;600;700;800&family=IBM+Plex+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:site_name" content="AgentLine" />
    <meta property="og:locale" content="zh_CN" />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <script is:inline type="application/ld+json" set:html={siteStructuredData} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to Main Content</a>
    <slot />
    <script is:inline>
    document.querySelectorAll('.article-content h2, .article-content h3, .article-body h2').forEach(function(h) {
      if (h.id) return;
      var slug = h.textContent.trim().toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
      h.id = slug;
      var a = document.createElement('a');
      a.href = '#' + slug;
      a.className = 'heading-anchor';
      a.setAttribute('aria-hidden', 'true');
      a.textContent = '#';
      h.prepend(a);
    });

    document.querySelectorAll('.anchor-strip').forEach(function(strip) {
      var links = Array.from(strip.querySelectorAll('a[href^="#"]'));
      if (!links.length) return;

      var sections = links
        .map(function(link) {
          var target = link.getAttribute('href');
          if (!target) return null;
          return document.getElementById(target.slice(1));
        })
        .filter(Boolean);

      if (!sections.length) return;

      function setActive(id) {
        links.forEach(function(link) {
          var active = link.getAttribute('href') === '#' + id;
          if (active) {
            link.setAttribute('aria-current', 'true');
          } else {
            link.removeAttribute('aria-current');
          }
        });
      }

      var observer = new IntersectionObserver(
        function(entries) {
          var visible = entries
            .filter(function(entry) { return entry.isIntersecting; })
            .sort(function(a, b) { return b.intersectionRatio - a.intersectionRatio; })[0];
          if (visible) setActive(visible.target.id);
        },
        {
          rootMargin: '-30% 0px -45% 0px',
          threshold: [0.2, 0.35, 0.6],
        }
      );

      sections.forEach(function(section) {
        observer.observe(section);
      });

      setActive(sections[0].id);
    });
    </script>
  </body>
</html>
