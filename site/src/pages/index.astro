<script is:inline>
document.querySelectorAll("[data-download-center]").forEach(function (root) {
  var tablist = root.querySelector("[role='tablist']");
  var tabs = Array.from(root.querySelectorAll("[role='tab']"));
  var panels = Array.from(root.querySelectorAll("[role='tabpanel']"));
  var hoverCards = Array.from(root.querySelectorAll(".download-action-group.has-hover-card"));

  if (!tablist || !tabs.length || !panels.length) return;

  function moveIndicator(tab) {
    var tabRect = tab.getBoundingClientRect();
    var listRect = tablist.getBoundingClientRect();
    tablist.style.setProperty("--download-indicator-x", tab.offsetLeft + "px");
    tablist.style.setProperty("--download-indicator-w", tabRect.width + "px");
    tablist.style.setProperty("--download-indicator-y", (tab.offsetTop - listRect.top + tablist.scrollTop) + "px");
  }

  function activate(tab, shouldFocus) {
    var panelId = tab.getAttribute("aria-controls");

    tabs.forEach(function (item) {
      var selected = item === tab;
      item.setAttribute("aria-selected", String(selected));
      item.setAttribute("tabindex", selected ? "0" : "-1");
    });

    panels.forEach(function (panel) {
      panel.hidden = panel.id !== panelId;
    });

    moveIndicator(tab);

    if (shouldFocus) {
      tab.focus();
    }
  }

  function step(current, direction) {
    var index = tabs.indexOf(current);
    var next = tabs[(index + direction + tabs.length) % tabs.length];
    activate(next, true);
  }

  tabs.forEach(function (tab) {
    tab.addEventListener("click", function () {
      activate(tab, false);
    });

    tab.addEventListener("keydown", function (event) {
      if (event.key === "ArrowRight") {
        event.preventDefault();
        step(tab, 1);
      } else if (event.key === "ArrowLeft") {
        event.preventDefault();
        step(tab, -1);
      } else if (event.key === "Home") {
        event.preventDefault();
        activate(tabs[0], true);
      } else if (event.key === "End") {
        event.preventDefault();
        activate(tabs[tabs.length - 1], true);
      }
    });
  });

  var initial = tabs.find(function (tab) {
    return tab.getAttribute("aria-selected") === "true";
  }) || tabs[0];

  requestAnimationFrame(function () {
    activate(initial, false);
  });

  window.addEventListener("resize", function () {
    var current = root.querySelector("[role='tab'][aria-selected='true']");
    if (current) moveIndicator(current);
  });

  hoverCards.forEach(function (group) {
    function openCard() {
      group.setAttribute("data-hover-card-open", "true");
    }

    function closeCard() {
      group.setAttribute("data-hover-card-open", "false");
    }

    group.setAttribute("data-hover-card-open", "false");
    group.addEventListener("mouseenter", openCard);
    group.addEventListener("mouseleave", closeCard);
    group.addEventListener("focusin", openCard);
    group.addEventListener("focusout", function (event) {
      if (!group.contains(event.relatedTarget)) {
        closeCard();
      }
    });
  });
});

document.querySelectorAll(".home-section-nav").forEach(function (nav) {
  var links = Array.from(nav.querySelectorAll('a[href^="#"]'));
  var sections = links
    .map(function (link) {
      var id = link.getAttribute("href").slice(1);
      return document.getElementById(id);
    })
    .filter(Boolean);

  if (!sections.length || !("IntersectionObserver" in window)) return;

  function setCurrent(id) {
    links.forEach(function (link) {
      if (link.getAttribute("href") === "#" + id) {
        link.setAttribute("aria-current", "true");
      } else {
        link.removeAttribute("aria-current");
      }
    });
  }

  var observer = new IntersectionObserver(
    function (entries) {
      var visible = entries
        .filter(function (entry) {
          return entry.isIntersecting;
        })
        .sort(function (a, b) {
          return b.intersectionRatio - a.intersectionRatio;
        })[0];

      if (visible) setCurrent(visible.target.id);
    },
    {
      rootMargin: "-35% 0px -45% 0px",
      threshold: [0.18, 0.32, 0.5],
    }
  );

  sections.forEach(function (section) {
    observer.observe(section);
  });
  setCurrent(sections[0].id);
});
</script>
