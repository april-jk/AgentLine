---
import { withBase } from "../lib/paths";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const productUpdates = [
  {
    label: "Feature launch",
    date: "March 3, 2026",
    title: "Remote Device Control closes the mobile dev loop",
    description:
      "AgentLine can stream Android devices, Android emulators, and iOS Simulators to your phone with low-latency video and touch input. Agents keep working on the dev machine, while you can inspect real app state away from the desk.",
    href: withBase("/remote-device-control"),
    linkLabel: "Read the launch note",
  },
  {
    label: "Product milestone",
    date: "January 21, 2026",
    title: "Public Relay makes secure remote supervision easier",
    description:
      "The optional relay lets you reach your local AgentLine host without port forwarding or VPN setup. Traffic stays end-to-end encrypted, so the relay only moves opaque ciphertext.",
    href: withBase("/public-relay"),
    linkLabel: "Read the relay announcement",
  },
  {
    label: "Category note",
    date: "February 24, 2026",
    title: "Claude Remote Control validates the phone-supervision workflow",
    description:
      "Anthropic's Remote Control is a strong signal for the category. AgentLine remains focused on the broader supervisor layer: multiple sessions, phone-initiated work, server-owned processes, and self-hosted access paths.",
    href: withBase("/claude-code-remote-control"),
    linkLabel: "Compare the workflows",
  },
];

const trustNotes = [
  {
    title: "How AgentLine uses official provider surfaces",
    description:
      "AgentLine does not spoof client identity or route consumer tokens through its own backend. It supervises official CLIs and SDK-backed sessions on your machine.",
    href: withBase("/tos-compliance"),
  },
  {
    title: "What subscription-access research means for users",
    description:
      "The practical rule is simple: prefer official CLIs and SDKs, keep authentication with the provider, and avoid token extraction paths that can break accounts.",
    href: withBase("/subscription-access-approaches"),
  },
];

const fieldNotes = [
  {
    title: "What I learned from high-throughput AI coding workflows",
    href: withBase("/ai-coding-workflow-openclaw"),
  },
  {
    title: "Why provider enforcement keeps pushing tools toward official CLIs",
    href: withBase("/google-openclaw-crackdown"),
  },
  {
    title: "Where autonomous-agent ideas overlap with supervised daily work",
    href: withBase("/openclaw-and-agentline"),
  },
];
---

<BaseLayout
  title="Product Updates - AgentLine"
  description="AgentLine product updates, feature launches, and trust notes."
>
  <Header activePage="news" />

  <main class="news-main">
    <section class="news-hero">
      <div class="container news-hero-layout">
        <div class="news-hero-copy">
          <p class="eyebrow">Product Updates</p>
          <h1>AgentLine 的产品进展，放在这里。</h1>
          <p>
            这里记录 AgentLine 的功能发布、远程监督能力和信任边界。
            内容不多，但每一条都贴着产品本身。
          </p>
          <div class="news-hero-actions">
            <a href={withBase("/#install")} class="btn btn-primary">下载 AgentLine</a>
            <a href="https://github.com/april-jk/AgentLine" class="btn btn-secondary">查看 GitHub</a>
          </div>
        </div>
        <figure class="news-hero-shot">
          <img
            src={withBase("/screenshots/overview-projects-real.png")}
            alt="AgentLine project overview with multiple supervised sessions"
            width="1440"
            height="1000"
            loading="eager"
          />
        </figure>
      </div>
    </section>

    <section class="news-section">
      <div class="container news-section-layout">
        <div class="news-section-heading">
          <p class="eyebrow">Latest</p>
          <h2>产品更新</h2>
          <p>真正影响使用方式的更新，优先放在这里。</p>
        </div>
        <div class="product-update-list">
          {productUpdates.map((item) => (
            <article class="product-update-item">
              <div class="product-update-meta">
                <span>{item.label}</span>
                <time>{item.date}</time>
              </div>
              <div class="product-update-body">
                <h3>{item.title}</h3>
                <p>{item.description}</p>
                <a href={item.href}>{item.linkLabel}</a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="news-section news-section-soft">
      <div class="container news-section-layout">
        <div class="news-section-heading">
          <p class="eyebrow">Trust</p>
          <h2>信任边界</h2>
          <p>AgentLine 的核心原则是让会话留在你的机器上，用官方入口连接模型。</p>
        </div>
        <div class="trust-note-grid">
          {trustNotes.map((item) => (
            <article class="trust-note">
              <h3>{item.title}</h3>
              <p>{item.description}</p>
              <a href={item.href}>Read note</a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="news-section field-notes-section">
      <div class="container field-notes-layout">
        <div>
          <p class="eyebrow">Field Notes</p>
          <h2>相关思考</h2>
        </div>
        <div class="field-note-list">
          {fieldNotes.map((item) => (
            <a href={item.href}>{item.title}</a>
          ))}
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .news-main {
    padding-bottom: 72px;
  }

  .news-hero {
    padding: clamp(52px, 8vw, 96px) 0 clamp(44px, 7vw, 84px);
    border-bottom: 1px solid var(--border);
  }

  .news-hero-layout {
    display: grid;
    grid-template-columns: minmax(0, 0.82fr) minmax(360px, 1.18fr);
    gap: clamp(34px, 6vw, 84px);
    align-items: center;
  }

  .news-hero-copy {
    max-width: 48ch;
  }

  .news-hero-copy h1 {
    font-size: clamp(2.1rem, 4.3vw, 4rem);
    margin-bottom: 18px;
  }

  .news-hero-copy p:not(.eyebrow) {
    font-size: 1.06rem;
  }

  .news-hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }

  .news-hero-shot {
    margin: 0;
    border: 1px solid var(--border);
    border-radius: 28px;
    overflow: hidden;
    background: linear-gradient(180deg, #152238, #0f1a2c);
    box-shadow: var(--shadow-soft);
    padding: 18px;
  }

  .news-hero-shot img {
    display: block;
    width: 100%;
    height: clamp(320px, 34vw, 470px);
    object-fit: cover;
    object-position: top left;
    border-radius: 20px;
  }

  .news-section {
    padding: clamp(56px, 8vw, 88px) 0;
  }

  .news-section-soft {
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    background: color-mix(in oklab, var(--bg-soft), transparent 28%);
  }

  .news-section-layout {
    display: grid;
    grid-template-columns: minmax(220px, 0.42fr) minmax(0, 1fr);
    gap: clamp(32px, 6vw, 86px);
    align-items: start;
  }

  .news-section-heading {
    max-width: 32ch;
  }

  .news-section-heading h2,
  .field-notes-layout h2 {
    margin-bottom: 12px;
  }

  .product-update-list {
    display: grid;
    gap: 0;
    border-top: 1px solid var(--border);
  }

  .product-update-item {
    display: grid;
    grid-template-columns: minmax(150px, 0.32fr) minmax(0, 1fr);
    gap: clamp(20px, 4vw, 56px);
    padding: 28px 0;
    border-bottom: 1px solid var(--border);
  }

  .product-update-meta {
    display: grid;
    align-content: start;
    gap: 8px;
  }

  .product-update-meta span {
    color: var(--accent);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .product-update-meta time {
    color: var(--text-muted);
    font-size: 0.92rem;
  }

  .product-update-body {
    max-width: 64ch;
  }

  .product-update-body h3,
  .trust-note h3 {
    font-size: 1.2rem;
    margin-bottom: 10px;
  }

  .product-update-body a,
  .trust-note a,
  .field-note-list a {
    color: var(--accent);
    font-weight: 700;
    text-decoration: none;
  }

  .product-update-body a:hover,
  .trust-note a:hover,
  .field-note-list a:hover {
    text-decoration: underline;
  }

  .trust-note-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .trust-note {
    border: 1px solid var(--border);
    border-radius: 8px;
    background: color-mix(in oklab, var(--bg-primary), transparent 8%);
    padding: 22px;
    box-shadow: 0 18px 42px color-mix(in oklab, var(--text-primary), transparent 95%);
  }

  .field-notes-section {
    padding-bottom: 28px;
  }

  .field-notes-layout {
    display: grid;
    grid-template-columns: minmax(220px, 0.42fr) minmax(0, 1fr);
    gap: clamp(28px, 5vw, 72px);
    align-items: start;
  }

  .field-note-list {
    display: grid;
    gap: 12px;
    border-top: 1px solid var(--border);
    padding-top: 18px;
  }

  .field-note-list a {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    padding-bottom: 12px;
    border-bottom: 1px solid color-mix(in oklab, var(--border), transparent 28%);
    color: var(--text-secondary);
  }

  .field-note-list a::after {
    content: "Read";
    color: var(--accent);
    font-size: 0.86rem;
    flex: 0 0 auto;
  }

  @media (max-width: 940px) {
    .news-hero-layout,
    .news-section-layout,
    .field-notes-layout {
      grid-template-columns: 1fr;
    }

    .news-hero-shot img {
      height: auto;
    }

    .trust-note-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .news-hero {
      padding-top: 40px;
    }

    .product-update-item {
      grid-template-columns: 1fr;
      gap: 12px;
      padding: 24px 0;
    }

    .news-hero-actions .btn {
      width: 100%;
    }

    .news-main {
      padding-bottom: 40px;
    }

    .news-hero {
      padding: 32px 0 38px;
    }

    .news-hero-copy h1 {
      font-size: clamp(2rem, 9vw, 2.55rem);
      line-height: 1.12;
      margin-bottom: 14px;
    }

    .news-hero-copy p:not(.eyebrow) {
      font-size: 1rem;
      line-height: 1.68;
    }

    .news-hero-actions {
      margin-top: 22px;
    }

    .news-hero-shot {
      padding: 10px;
      border-radius: 18px;
    }

    .news-hero-shot img {
      height: 190px;
      border-radius: 12px;
    }

    .news-section {
      padding: 44px 0;
    }

    .news-section-heading {
      max-width: none;
    }

    .news-section-heading h2,
    .field-notes-layout h2 {
      margin-bottom: 8px;
    }

    .product-update-list {
      border-top: none;
      gap: 14px;
    }

    .product-update-item {
      border: 1px solid var(--border);
      border-radius: 8px;
      background: color-mix(in oklab, var(--bg-primary), transparent 10%);
      padding: 20px;
      box-shadow: 0 18px 42px color-mix(in oklab, var(--text-primary), transparent 95%);
    }

    .product-update-meta {
      grid-template-columns: 1fr;
      gap: 4px;
    }

    .product-update-body h3,
    .trust-note h3 {
      font-size: 1.08rem;
      line-height: 1.25;
    }

    .product-update-body p,
    .trust-note p {
      line-height: 1.65;
    }

    .trust-note {
      padding: 20px;
    }

    .field-note-list {
      padding-top: 10px;
    }

    .field-note-list a {
      align-items: center;
      padding: 13px 0;
      line-height: 1.45;
    }

    .field-note-list a::after {
      content: "Read";
      font-size: 0.8rem;
    }
  }
</style>
