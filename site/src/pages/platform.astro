---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<BaseLayout
  title="AgentLine Platform | 持久运行层"
  description="讲清 AgentLine 的执行稳定性：会话托管、多会话编排、跨入口互通。"
>
  <Header activePage="platform" />
  <main id="main-content" class="topic-main page-platform">
    <section class="topic-hero">
      <div class="container">
        <p class="eyebrow">Platform</p>
        <h1>为 Agent 工作流而生的持久运行层</h1>
        <p class="lead">把执行与监督拆开：执行驻留在你的机器，监督跟随你的设备。</p>
      </div>
    </section>

    <section class="anchor-wrap">
      <div class="container">
        <nav class="anchor-strip" aria-label="Platform anchors">
          <a href="#runtime">Runtime Model</a>
          <a href="#orchestration">Multi-Session Orchestration</a>
          <a href="#interop">Session Interop</a>
          <a href="#workflow">典型工作流</a>
        </nav>
      </div>
    </section>

    <div class="container snap-deck">
      <section id="runtime" class="story-panel">
        <figure class="story-media">
          <img src="/screenshots/overview-projects-real.png" alt="Project overview showing multiple tracked workspaces in AgentLine" width="1440" height="1000" fetchpriority="high" />
        </figure>
        <div class="story-copy">
          <p class="kicker">01 / Runtime</p>
          <h2>Runtime Model</h2>
          <p>会话由服务端进程托管。断网、关浏览器、切设备，不中断正在进行的任务。</p>
        </div>
      </section>

      <section id="orchestration" class="story-panel is-reverse">
        <figure class="story-media">
          <img src="/screenshots/sessions-list-real.png" alt="Session list with filters for orchestrating multiple tasks" width="1440" height="1000" loading="lazy" />
        </figure>
        <div class="story-copy">
          <p class="kicker">02 / Orchestration</p>
          <h2>Multi-Session Orchestration</h2>
          <p>一个面板管理多个并行项目，按优先级调度注意力，而不是按窗口调度注意力。</p>
        </div>
      </section>

      <section id="interop" class="story-panel">
        <figure class="story-media">
          <img src="/screenshots/session-running-real.png" alt="Unified session detail view across desktop and mobile" width="1440" height="1000" loading="lazy" />
        </figure>
        <div class="story-copy">
          <p class="kicker">03 / Interop</p>
          <h2>Session Interop</h2>
          <p>来自 CLI、编辑器、Web 的会话可汇入同一监督界面，保留上下文连续性。</p>
        </div>
      </section>

      <section id="workflow" class="story-panel is-reverse">
        <figure class="story-media">
          <img src="/screenshots/session-complete-real.png" alt="Completed session with clear tool steps and final result" width="1440" height="1000" loading="lazy" />
        </figure>
        <div class="story-copy">
          <p class="kicker">04 / Workflow</p>
          <h2>典型工作流</h2>
          <ol>
            <li>在桌面启动任务</li>
            <li>离开工位后手机接管监督</li>
            <li>收到阻塞提醒并快速审批</li>
            <li>回到桌面继续深度开发</li>
          </ol>
        </div>
      </section>
    </div>

    <section class="section final-cta">
      <div class="container cta-row">
        <a href="/mobile-supervision" class="btn btn-secondary">继续看移动体验</a>
        <a href="/install" class="btn btn-primary">立即安装 AgentLine</a>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
