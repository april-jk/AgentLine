---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<BaseLayout
  title="AgentLine Security | 远程可用，不失控制"
  description="连接拓扑与加密边界并重：Authentication、Encryption、Deployment Modes、Control Checklist。"
>
  <Header activePage="security" />
  <main id="main-content" class="topic-main page-security">
    <section class="topic-hero">
      <div class="container">
        <p class="eyebrow">Security & Relay</p>
        <h1>远程可用，不等于失去控制</h1>
        <p class="lead">AgentLine 提供可选择的连接拓扑与加密边界，让便捷与控制并存。</p>
      </div>
    </section>

    <section class="anchor-wrap">
      <div class="container">
        <nav class="anchor-strip" aria-label="Security anchors">
          <a href="#auth">Authentication Boundary</a>
          <a href="#encryption">Encrypted Relay Path</a>
          <a href="#topology">Deployment Modes</a>
          <a href="#control">Control Checklist</a>
        </nav>
      </div>
    </section>

    <div class="container snap-deck">
      <section id="auth" class="story-panel">
        <figure class="story-media">
          <img src="/screenshots/session-complete-real.png" alt="Desktop session summarizing relay security details" width="1440" height="1000" fetchpriority="high" />
        </figure>
        <div class="story-copy">
          <p class="kicker">01 / Auth</p>
          <h2>Authentication Boundary</h2>
          <p>通过口令与会话身份机制建立接入控制，避免“谁知道地址谁就能进”。</p>
        </div>
      </section>

      <section id="encryption" class="story-panel is-reverse">
        <figure class="story-media">
          <img src="/screenshots/session-running-real.png" alt="Live session workflow where approvals and relay traffic remain in context" width="1440" height="1000" loading="lazy" />
        </figure>
        <div class="story-copy">
          <p class="kicker">02 / Encryption</p>
          <h2>Encrypted Relay Path</h2>
          <p>在中继场景下，链路按加密边界传输，减少中间节点可见信息面。</p>
        </div>
      </section>

      <section id="topology" class="story-panel">
        <figure class="story-media">
          <img src="/screenshots/overview-projects-real.png" alt="Host overview for selecting where sessions live and how they are reached" width="1440" height="1000" loading="lazy" />
        </figure>
        <div class="story-copy">
          <p class="kicker">03 / Topology</p>
          <h2>Deployment Modes</h2>
          <p>支持 LAN / Tailscale / Relay / 自托管 relay 等不同拓扑，按团队风险偏好选择。</p>
        </div>
      </section>

      <section id="control" class="story-panel is-reverse">
        <figure class="story-media">
          <img src="/screenshots/sessions-list-real.png" alt="Filtered session controls for reviewing and managing remote work" width="1440" height="1000" loading="lazy" />
        </figure>
        <div class="story-copy">
          <p class="kicker">04 / Control</p>
          <h2>Control Checklist</h2>
          <ul>
            <li>最小暴露面</li>
            <li>按环境分离访问凭据</li>
            <li>关键操作保留审批</li>
            <li>升级策略与版本兼容检查</li>
          </ul>
        </div>
      </section>
    </div>

    <section class="section final-cta">
      <div class="container cta-row">
        <a href="/compare" class="btn btn-secondary">查看能力对比</a>
        <a href="/install" class="btn btn-primary">立即安装 AgentLine</a>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
